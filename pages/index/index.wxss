.home {
  min-height: 100vh;
  background: #f8f3e8;
  padding-bottom: 140rpx;
}

.status-spacer {
  background: #d4b26a;
}

.hero-section {
  position: relative;
  height: 620rpx;
  margin-top: -1rpx;
  background: #d4b26a;
  overflow: hidden;
}

.hero-copy {
  position: absolute;
  left: 0;
  right: 0;
  top: 44rpx;
  z-index: 2;
  text-align: center;
}

.hero-pinyin {
  font-size: 18rpx;
  letter-spacing: 5rpx;
  color: #7a6a55;
}

.hero-title {
  margin-top: 6rpx;
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #3c3327;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6e614c;
}

.hero-badge {
  position: absolute;
  right: 42rpx;
  top: 176rpx;
  z-index: 2;
  padding: 8rpx 18rpx;
  border: 1rpx solid #7a6a55;
  border-radius: 28rpx;
  font-size: 19rpx;
  color: #3c3327;
  background: rgba(255, 255, 255, 0.25);
}

.hero-illustration {
  position: absolute;
  left: 0;
  bottom: 36rpx;
  width: 100%;
  height: 400rpx;
}

.hero-tip {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  z-index: 3;
  transform: translateX(-50%);
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #6b5b45;
  font-size: 18rpx;
}

.service-row {
  position: relative;
  z-index: 4;
  display: flex;
  gap: 20rpx;
  margin: -32rpx 24rpx 0;
}

.service-card {
  flex: 1;
  height: 170rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
}

.service-cold {
  background: #7f9b84;
}

.service-box {
  background: #bd8c66;
}

.service-icon {
  width: 62rpx;
  height: 62rpx;
}

.service-name {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
}

.service-en {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 28rpx 16rpx;
  color: #3c3327;
  font-size: 30rpx;
  font-weight: 600;
}

.section-link {
  color: #9c8b74;
  font-size: 20rpx;
  font-weight: 400;
}

.temp-card {
  margin: 0 20rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.temp-now {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.temp-value {
  color: #3f6b4a;
  font-size: 60rpx;
  font-weight: 600;
  line-height: 1.1;
}

.temp-tag {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 28rpx;
  background: #edf5ed;
  color: #5c7f63;
  font-size: 19rpx;
}

.check-icon {
  width: 22rpx;
  height: 22rpx;
}

.temp-desc {
  margin-top: 6rpx;
  color: #a9997f;
  font-size: 18rpx;
}

.temp-wave {
  position: relative;
  height: 100rpx;
  margin-top: 18rpx;
}

.wave-line {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  top: 50rpx;
  height: 2rpx;
  background: #9ac9ad;
  border-radius: 2rpx;
}

.wave-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #5d9a72;
}

.dot-a { left: 3%; top: 51rpx; }
.dot-b { left: 35%; top: 31rpx; }
.dot-c { left: 66%; top: 61rpx; }
.dot-d { right: 3%; top: 41rpx; }

.temp-steps {
  display: flex;
  justify-content: space-between;
  margin-top: 6rpx;
  color: #8b7b63;
  font-size: 18rpx;
}

.supply-card {
  margin: 24rpx 20rpx 0;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.supply-heading {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #3c3327;
  font-size: 28rpx;
  font-weight: 600;
}

.guide-icon {
  width: 38rpx;
  height: 38rpx;
}

.supply-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f1e8d7;
}

.supply-num {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #eef4ee;
  color: #4f7b58;
  font-size: 22rpx;
}

.supply-item-title {
  color: #3c3327;
  font-size: 26rpx;
  font-weight: 500;
}

.supply-item-desc {
  margin-top: 4rpx;
  color: #9c8b74;
  font-size: 20rpx;
}

.bottom-space {
  height: 20rpx;
}
