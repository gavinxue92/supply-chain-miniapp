.detail-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.inline-state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #8a8f99;
  font-size: 26rpx;
}

.hero {
  height: 560rpx;
  background: #e8ebef;
}

.hero-image {
  display: block;
  width: 100%;
  height: 100%;
}

.detail-card,
.info-card {
  margin: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.detail-name {
  font-size: 34rpx;
  font-weight: 500;
  color: #222222;
}

.detail-tags {
  margin-top: 12rpx;
}

.detail-tags text {
  display: inline-block;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: #fff3d6;
  color: #9a6b00;
  font-size: 20rpx;
}

.notice-mini {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #8a8f99;
}

.card-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.rich {
  font-size: 26rpx;
  line-height: 1.7;
  color: #3f4550;
  word-break: break-all;
}

.back {
  margin: 20rpx auto 0;
  padding: 12rpx 40rpx;
  border-radius: 32rpx;
  background: #3f6b4a;
  color: #ffffff;
  font-size: 26rpx;
}
