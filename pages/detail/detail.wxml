<view class="detail-page">
  <view wx:if="{{state === 'loading'}}" class="inline-state">正在加载产品详情…</view>
  <state-view
    wx:elif="{{state === 'notFound'}}"
    state="notFound"
    message="商品已下架或不存在"
    bind:back="onBack"
  />
  <state-view wx:elif="{{state === 'error'}}" state="error" message="{{errorMessage}}" bind:retry="onRetry" />

  <block wx:elif="{{detail}}">
    <swiper class="hero" indicator-dots="{{detail.images.length > 1}}" circular>
      <swiper-item wx:for="{{detail.images}}" wx:key="*this">
        <image-view class="hero-image" src="{{item}}" hint="主图加载失败" />
      </swiper-item>
    </swiper>

    <view class="detail-card">
      <view class="detail-name">{{detail.name}}</view>
      <view class="detail-tags"><text>参考价</text></view>
      <spec-list specifications="{{detail.specifications}}" />
      <view class="notice-mini">{{detail.notice}}</view>
    </view>

    <view class="info-card">
      <view class="card-title">图文详情</view>
      <rich-text class="rich" nodes="{{detail.detailHtml}}" />
    </view>

    <contact-card wx:if="{{detail.contact}}" contact="{{detail.contact}}" />

    <button class="back" hover-class="none" bindtap="onBack">返回上一级</button>
  </block>
</view>
