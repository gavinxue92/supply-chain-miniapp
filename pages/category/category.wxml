<view class="category-page">
  <page-header
    title="小陈食品"
    show-home="{{true}}"
    show-search="{{true}}"
    bind:search="onSearchTap"
  />

  <view wx:if="{{state === 'loading'}}" class="inline-state">正在加载分类…</view>
  <state-view wx:elif="{{state === 'error'}}" state="error" message="{{errorMessage}}" bind:retry="onRetry" />
  <state-view wx:elif="{{state === 'empty'}}" state="empty" message="暂无分类数据" />

  <view wx:else class="category-body">
    <scroll-view class="first-column" scroll-y>
      <view
        wx:for="{{firstLevel}}"
        wx:key="id"
        class="first-item {{activeFirstId === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onFirstSelect"
      >
        <view wx:if="{{activeFirstId === item.id}}" class="first-active-bar"></view>
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <scroll-view
      id="group-list"
      class="second-column"
      scroll-y
      scroll-into-view="{{activeGroupAnchor}}"
      bindscroll="onListScroll"
    >
      <view wx:for="{{groups}}" wx:for-item="group" wx:key="id" id="{{group.id}}" class="product-group">
        <view class="group-title">{{group.name}}</view>

        <view wx:if="{{group.state === 'idle' || group.state === 'loading'}}" class="group-state">加载中</view>
        <view wx:elif="{{group.state === 'error'}}" class="group-state">
          <text class="group-error">{{group.message}}</text>
          <view class="group-retry" hover-class="retry-hover" data-id="{{group.categoryId}}" bindtap="onRetryGroup">重试</view>
        </view>
        <view wx:elif="{{group.state === 'empty'}}" class="group-state">暂无产品</view>
        <block wx:else>
          <product-row
            wx:for="{{group.products}}"
            wx:for-item="product"
            wx:key="id"
            product="{{product}}"
            bind:select="onProductSelect"
          />
        </block>
      </view>

      <view class="list-bottom-space" />
    </scroll-view>
  </view>
</view>
