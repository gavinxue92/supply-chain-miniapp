.category-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #ffffff;
}

.inline-state {
  padding: 120rpx 40rpx;
  text-align: center;
  color: #9c8b74;
  font-size: 26rpx;
}

.category-body {
  display: flex;
  flex: 1;
  min-height: 0;
}

.first-column {
  width: 160rpx;
  flex-shrink: 0;
  height: 100%;
  background: #f7f7f5;
  border-right: 1rpx solid #e6e8ea;
}

.first-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  color: #5f5e5a;
  font-size: 26rpx;
  text-align: center;
}

.first-item.active {
  background: #ffffff;
  color: #2c2c2a;
  font-weight: 500;
}

.first-active-bar {
  position: absolute;
  left: 0;
  top: 26rpx;
  width: 6rpx;
  height: 44rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #3b6d11;
}

.second-column {
  flex: 1;
  min-width: 0;
  height: 100%;
  background: #ffffff;
}

.product-group {
  background: #ffffff;
}

.group-title {
  position: sticky;
  top: 0;
  z-index: 2;
  padding: 18rpx 20rpx 12rpx;
  background: #ffffff;
  color: #2c2c2a;
  font-size: 28rpx;
  font-weight: 500;
}

.group-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 20rpx;
  color: #999999;
  font-size: 24rpx;
}

.group-error {
  max-width: 100%;
  text-align: center;
}

.group-retry {
  margin-top: 16rpx;
  padding: 8rpx 28rpx;
  border-radius: 24rpx;
  background: #f5f5f5;
  color: #3b6d11;
  font-size: 24rpx;
}

.retry-hover {
  opacity: 0.7;
}

.list-bottom-space {
  height: 140rpx;
}
