.mine-page {
  min-height: 100vh;
  background: #ffffff;
}

.floating-music {
  position: fixed;
  right: -16rpx;
  top: 400rpx;
  z-index: 5;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 6rpx 22rpx rgba(0, 0, 0, 0.08);
}

.floating-music image {
  width: 44rpx;
  height: 44rpx;
}

.profile {
  padding: 44rpx 32rpx 36rpx;
  background: linear-gradient(135deg, #ffffff, #f2f2f2);
}

.welcome {
  color: #7a6a55;
  font-size: 26rpx;
}

.user-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.user-name {
  color: #2b2b2b;
  font-size: 34rpx;
  font-weight: 600;
}

.login-button {
  margin: 16rpx 0 0;
  padding: 8rpx 26rpx;
  border: 1rpx solid #d9d9d9;
  border-radius: 28rpx;
  background: transparent;
  color: #5b5b5b;
  font-size: 22rpx;
  line-height: 1.6;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
}

.stats {
  display: flex;
  margin-top: 30rpx;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat-value {
  color: #2b2b2b;
  font-size: 26rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 6rpx;
  color: #7a6a55;
  font-size: 22rpx;
}

.member-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10rpx 24rpx 0;
  padding: 42rpx 32rpx;
  min-height: 220rpx;
  border-radius: 28rpx;
  background: linear-gradient(120deg, #d9d9d9, #b9b9b9);
  color: #ffffff;
}

.member-title {
  font-size: 32rpx;
  font-weight: 600;
}

.member-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.member-right {
  text-align: right;
  font-size: 24rpx;
}

.member-link {
  margin-top: 12rpx;
  font-size: 22rpx;
  opacity: 0.9;
}

.feature-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 36rpx 12rpx;
  margin: 24rpx;
  padding: 40rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 52rpx;
  height: 52rpx;
}

.feature-label {
  margin-top: 10rpx;
  color: #3c3327;
  font-size: 24rpx;
}

.bottom-space {
  height: 160rpx;
}
