.product-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.row-hover {
  background: #fafafa;
}

.row-image {
  display: block;
  width: 140rpx;
  height: 140rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.row-body {
  flex: 1;
  min-width: 0;
}

.row-name {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: #2c2c2a;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.35;
}

.row-spec {
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #999999;
  font-size: 22rpx;
}

.row-price {
  display: flex;
  align-items: baseline;
  margin-top: 8rpx;
  color: #ff4d4f;
}

.currency {
  font-size: 22rpx;
}

.amount {
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.row-arrow::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid #bbbbbb;
  border-right: 2rpx solid #bbbbbb;
  transform: rotate(45deg);
}
