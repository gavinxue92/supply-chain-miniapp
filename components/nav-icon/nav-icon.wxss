.nav-icon {
  position: relative;
  display: inline-block;
  color: inherit;
  flex-shrink: 0;
}

.home-roof {
  position: absolute;
  left: 1rpx;
  top: 5rpx;
  width: 0;
  height: 0;
  border-left: 19rpx solid transparent;
  border-right: 19rpx solid transparent;
  border-bottom: 14rpx solid currentColor;
}

.home-body {
  position: absolute;
  left: 8rpx;
  top: 18rpx;
  width: 24rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-top: 0;
}

.grid-cell {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx;
}

.grid-cell:nth-child(1) { left: 2rpx; top: 2rpx; }
.grid-cell:nth-child(2) { right: 2rpx; top: 2rpx; }
.grid-cell:nth-child(3) { left: 2rpx; bottom: 2rpx; }
.grid-cell:nth-child(4) { right: 2rpx; bottom: 2rpx; }

.mine-head {
  position: absolute;
  left: 13rpx;
  top: 3rpx;
  width: 14rpx;
  height: 14rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.mine-body {
  position: absolute;
  left: 6rpx;
  top: 20rpx;
  width: 28rpx;
  height: 16rpx;
  border: 2rpx solid currentColor;
  border-bottom: 0;
  border-radius: 16rpx 16rpx 0 0;
}

.search-glass {
  position: absolute;
  left: 2rpx;
  top: 2rpx;
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}

.search-handle {
  position: absolute;
  right: 4rpx;
  bottom: 7rpx;
  width: 15rpx;
  height: 2rpx;
  background: currentColor;
  transform: rotate(45deg);
}

.back-chevron {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  width: 15rpx;
  height: 15rpx;
  border-left: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  transform: rotate(45deg);
}

.truck-box {
  position: absolute;
  left: 2rpx;
  top: 8rpx;
  width: 22rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
}

.truck-cab {
  position: absolute;
  right: 2rpx;
  top: 13rpx;
  width: 12rpx;
  height: 13rpx;
  border: 2rpx solid currentColor;
  border-left: 0;
  border-bottom: 0;
  transform: skewY(-20deg);
}

.truck-wheel {
  position: absolute;
  left: 6rpx;
  bottom: 2rpx;
  width: 8rpx;
  height: 8rpx;
  background: currentColor;
  border-radius: 50%;
}

.truck-wheel-right {
  left: auto;
  right: 5rpx;
}

.box-top {
  position: absolute;
  left: 6rpx;
  top: 4rpx;
  width: 28rpx;
  height: 10rpx;
  border: 2rpx solid currentColor;
  transform: skewY(-18deg);
}

.box-body {
  position: absolute;
  left: 6rpx;
  top: 14rpx;
  width: 28rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
}

.thermo-stem {
  position: absolute;
  left: 17rpx;
  top: 3rpx;
  width: 6rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
}

.thermo-bulb {
  position: absolute;
  left: 13rpx;
  bottom: 2rpx;
  width: 14rpx;
  height: 14rpx;
  background: currentColor;
  border-radius: 50%;
}
