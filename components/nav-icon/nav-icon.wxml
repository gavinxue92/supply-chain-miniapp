<view class="nav-icon" style="width:{{size}}rpx;height:{{size}}rpx">
  <block wx:if="{{name === 'home'}}">
    <view class="home-roof"></view>
    <view class="home-body"></view>
  </block>
  <block wx:elif="{{name === 'category'}}">
    <view class="grid-cell"></view>
    <view class="grid-cell"></view>
    <view class="grid-cell"></view>
    <view class="grid-cell"></view>
  </block>
  <block wx:elif="{{name === 'mine'}}">
    <view class="mine-head"></view>
    <view class="mine-body"></view>
  </block>
  <block wx:elif="{{name === 'search'}}">
    <view class="search-glass"></view>
    <view class="search-handle"></view>
  </block>
  <block wx:elif="{{name === 'back'}}">
    <view class="back-chevron"></view>
  </block>
  <block wx:elif="{{name === 'truck'}}">
    <view class="truck-box"></view>
    <view class="truck-cab"></view>
    <view class="truck-wheel"></view>
    <view class="truck-wheel truck-wheel-right"></view>
  </block>
  <block wx:elif="{{name === 'box'}}">
    <view class="box-top"></view>
    <view class="box-body"></view>
  </block>
  <block wx:elif="{{name === 'thermometer'}}">
    <view class="thermo-stem"></view>
    <view class="thermo-bulb"></view>
  </block>
</view>
