.searchbox {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 44rpx;
  background: #f4f4f4;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.45;
}

.input {
  flex: 1;
  margin: 0 18rpx;
  font-size: 28rpx;
  color: #2b2b2b;
}

.placeholder {
  color: #b7b7b7;
}

.search-action {
  padding-left: 12rpx;
  color: #7a6a55;
  font-size: 28rpx;
}
