.page-header {
  background: #ffffff;
}

.header-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.capsule {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e6e8ea;
  border-radius: 32rpx;
  background: #ffffff;
  color: #222222;
}

.left-capsule {
  gap: 8rpx;
}

.cap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 44rpx;
}

.cap-icon {
  width: 36rpx;
  height: 36rpx;
}

.divider {
  width: 1rpx;
  height: 28rpx;
  background: #e6e8ea;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #222222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.dots {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.target {
  width: 26rpx;
  height: 26rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.target-dot {
  width: 10rpx;
  height: 10rpx;
  background: currentColor;
  border-radius: 50%;
}
