.page-header {
  background: #ffffff;
}

.header-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.capsule {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 174rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e6e8ea;
  border-radius: 32rpx;
  background: #ffffff;
  color: #222222;
}

.left-capsule {
  gap: 8rpx;
}

.cap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
}

.cap-icon {
  width: 40rpx;
  height: 40rpx;
}

.divider {
  width: 1rpx;
  height: 28rpx;
  background: #e6e8ea;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #222222;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
