.contact-card {
  margin: 20rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 20rpx;
}

.card-title {
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.contact-item {
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.contact-item:first-of-type {
  border-top: 0;
}

.contact-name {
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.contact-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 6rpx 0;
}

.contact-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 24rpx;
  color: #3f4550;
}

.contact-actions {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
}

.mini-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: auto;
  height: 44rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #fff3d6;
  color: #9a6b00;
  font-size: 20rpx;
  line-height: 1;
}

.qr-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.qr-image {
  display: block;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.qr-hint {
  font-size: 22rpx;
  color: #8a8f99;
}
