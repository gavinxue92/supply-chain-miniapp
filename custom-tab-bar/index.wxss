.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 124rpx;
  padding: 10rpx 24rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab-card {
  width: 118rpx;
  height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 38rpx;
}

.tab-item.active .tab-card {
  background: #e6f1e7;
}

.tab-icon {
  width: 36rpx;
  height: 36rpx;
  filter: grayscale(1) opacity(0.45);
}

.tab-item.active .tab-icon {
  filter: none;
}

.tab-text {
  margin-top: 2rpx;
  color: #9c8b74;
  font-size: 21rpx;
}

.tab-item.active .tab-text {
  color: #4f7b58;
  font-weight: 600;
}
