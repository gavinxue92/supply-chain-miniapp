<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{active === index ? 'active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
    bindtap="onTap"
  >
    <view class="tab-card">
      <image class="tab-icon" src="{{item.icon}}" mode="aspectFit" />
      <text class="tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
